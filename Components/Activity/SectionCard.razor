<div class="card shadow-sm mb-3">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-2 px-3"
         style="cursor:pointer;" @onclick="ToggleCollapsed">
        <div class="d-flex align-items-center gap-2">
            <span class="fs-5">@Icon</span>
            <h5 class="mb-0 fw-semibold">@Title</h5>
            <span class="text-muted small ms-2">@(_collapsed ? "▸" : "▾")</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            @if (IsLoading)
            {
                <span class="spinner-border spinner-border-sm text-primary" role="status"></span>
            }
            else
            {
                @if (SummaryContent != null)
                {
                    <span class="small text-muted d-none d-sm-inline">@SummaryContent</span>
                }
                @if (Error != null)
                {
                    <span class="badge bg-danger rounded-pill">error</span>
                }
                <span class="badge bg-primary rounded-pill">@Count</span>
            }
        </div>
    </div>

    @if (!_collapsed)
    {
        @if (IsLoading)
        {
            <SectionSpinner Label="@LoadingLabel" />
        }
        else if (Error != null)
        {
            <SectionError Message="@Error" />
        }
        else if (Count == 0)
        {
            <div class="card-body text-muted fst-italic">(none)</div>
        }
        else
        {
            @ChildContent
        }
    }
</div>

@code {
    [Parameter] public string  Title        { get; set; } = string.Empty;
    [Parameter] public string  Icon         { get; set; } = string.Empty;
    [Parameter] public int     Count        { get; set; }
    [Parameter] public bool    IsLoading    { get; set; }
    [Parameter] public string? Error        { get; set; }
    [Parameter] public string  LoadingLabel { get; set; } = "Loading…";

    [Parameter] public RenderFragment? SummaryContent { get; set; }
    [Parameter] public RenderFragment? ChildContent   { get; set; }

    private bool _collapsed = true;

    private void ToggleCollapsed() => _collapsed = !_collapsed;
}
