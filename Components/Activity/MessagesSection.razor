<SectionCard Title="Chats" Icon="💬" Count="@(Items?.Count ?? 0)"
             IsLoading="@IsLoading" Error="@Error" LoadingLabel="Fetching Teams messages…">
    <SummaryContent>
        @if (Items?.Count > 0)
        {
            <text>↑ @Items.Count(m => m.IsSentByMe) sent · ↓ @Items.Count(m => !m.IsSentByMe) received</text>
        }
    </SummaryContent>
    <ChildContent>
        <div class="list-group list-group-flush">
            @foreach (var group in Items!.OrderBy(m => m.Timestamp).GroupBy(m => m.Source))
            {
                var chatName = group.Key;
                var sentCount = group.Count(m => m.IsSentByMe);
                var receivedCount = group.Count() - sentCount;
                var lastTimestamp = group.Max(m => m.Timestamp);
                var isCollapsed = IsChatCollapsed(chatName);

                <div class="list-group-item bg-light py-2 px-3"
                     style="cursor:pointer;" @onclick="() => ToggleChat(chatName)">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-semibold text-secondary small">
                            <span class="text-muted">@(isCollapsed ? "▸" : "▾")</span>
                            📁 @chatName
                        </span>
                        <span class="text-muted small">
                            ↑ @sentCount · ↓ @receivedCount · zuletzt @lastTimestamp.ToString("HH:mm")
                        </span>
                    </div>
                </div>
                @if (!isCollapsed)
                {
                    @foreach (var msg in group)
                    {
                        <div class="list-group-item list-group-item-action py-2 px-3 @(msg.IsSentByMe ? "list-group-item-success" : "")">
                            <div class="d-flex align-items-start gap-3">
                                <span class="text-muted small text-nowrap mt-1">@msg.Timestamp.ToString("HH:mm")</span>
                                <span class="fw-semibold text-nowrap sender-col small mt-1">@msg.SenderName</span>
                                @if (!string.IsNullOrEmpty(msg.WebLink))
                                {
                                    <a href="@msg.WebLink.Replace("https://", "msteams://")" class="text-body small text-decoration-none" title="In Teams öffnen">@msg.BodyPreview 🔗</a>
                                    <a href="@msg.WebLink" target="_blank" rel="noopener" class="small text-decoration-none ms-auto text-nowrap" title="Im Browser öffnen">🌐</a>
                                }
                                else
                                {
                                    <span class="text-body small">@msg.BodyPreview</span>
                                }
                            </div>
                        </div>
                    }
                }
            }
        </div>
    </ChildContent>
</SectionCard>

@code {
    [Parameter] public List<TeamMessage>? Items     { get; set; }
    [Parameter] public bool               IsLoading { get; set; }
    [Parameter] public string?            Error     { get; set; }

    private readonly HashSet<string> _expandedChats = [];

    // Chats start collapsed by default
    private bool IsChatCollapsed(string chatName) => !_expandedChats.Contains(chatName);

    private void ToggleChat(string chatName)
    {
        if (!_expandedChats.Add(chatName))
        {
            _expandedChats.Remove(chatName);
        }
    }
}


