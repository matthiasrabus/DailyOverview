<div class="card shadow-sm mb-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h5 class="mb-0 fw-semibold">🔧 Azure DevOps Commits</h5>
        @if (IsLoading)
        {
            <span class="spinner-border spinner-border-sm text-primary" role="status"></span>
        }
        else
        {
            <span class="badge bg-primary rounded-pill">@(Items?.Count ?? 0)</span>
        }
    </div>

    @if (IsLoading)
    {
        <SectionSpinner Label="Fetching DevOps commits…" />
    }
    else if (Error != null)
    {
        <SectionError Message="@Error" />
    }
    else if (Items?.Count == 0)
    {
        <div class="card-body text-muted fst-italic">(none)</div>
    }
    else if (Items != null)
    {
        <div class="list-group list-group-flush">
            @foreach (var group in Items.OrderBy(c => c.Timestamp).GroupBy(c => $"{c.Project} / {c.Repository}"))
            {
                <div class="list-group-item bg-light py-2 px-3 fw-semibold text-secondary small">
                    📦 @group.Key
                </div>
                @foreach (var commit in group)
                {
                    <div class="list-group-item list-group-item-action py-2 px-3">
                        <div class="d-flex align-items-center gap-3">
                            <span class="text-muted small text-nowrap">@commit.Timestamp.ToString("HH:mm")</span>
                            <code class="text-muted small">@commit.CommitId[..7]</code>
                            <a href="@commit.Url" target="_blank" class="text-truncate small text-decoration-none">
                                @commit.Message
                            </a>
                        </div>
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    [Parameter] public List<DevOpsCommit>? Items     { get; set; }
    [Parameter] public bool                IsLoading { get; set; }
    [Parameter] public string?             Error     { get; set; }
}
