<SectionCard Title="To Dos" Icon="✅" Count="@(Items?.Count ?? 0)"
             IsLoading="@IsLoading" Error="@Error" LoadingLabel="Fetching To Do tasks…">
    <SummaryContent>
        @if (Items?.Count > 0)
        {
            <text>✓ @Items.Count(t => t.IsCompleted) done</text>
        }
    </SummaryContent>
    <ChildContent>
        <div class="list-group list-group-flush">
            @foreach (var task in Items!.OrderBy(t => t.CreatedDateTime))
            {
                <div class="list-group-item list-group-item-action py-2 px-3">
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        <a href="https://to-do.office.com/tasks/id/@task.Id/details" target="_blank" rel="noopener"
                           class="text-decoration-none @(task.IsCompleted ? "text-decoration-line-through text-muted" : "fw-semibold")">
                            @task.Title 🔗
                        </a>
                        <div class="d-flex gap-1 ms-auto flex-shrink-0">
                            @if (task.DueDateTime.HasValue)
                            {
                                <span class="badge rounded-pill bg-light text-muted border">
                                    due @task.DueDateTime.Value.ToString("yyyy-MM-dd")
                                </span>
                            }
                            @if (!string.IsNullOrEmpty(task.Importance) && !task.Importance.Equals("normal", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge rounded-pill bg-warning text-dark">@task.Importance</span>
                            }
                            <span class="badge rounded-pill @(task.IsCompleted ? "bg-success" : "bg-secondary")">
                                @task.Status
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </ChildContent>
</SectionCard>

@code {
    [Parameter] public List<TodoTask>? Items     { get; set; }
    [Parameter] public bool            IsLoading { get; set; }
    [Parameter] public string?         Error     { get; set; }
}
