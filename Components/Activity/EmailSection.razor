<div class="card shadow-sm mb-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h5 class="mb-0 fw-semibold">📧 Email</h5>
        @if (IsLoading)
        {
            <span class="spinner-border spinner-border-sm text-primary" role="status"></span>
        }
        else
        {
            <span class="badge bg-primary rounded-pill">@(Items?.Count ?? 0)</span>
        }
    </div>

    @if (IsLoading)
    {
        <SectionSpinner Label="Fetching emails…" />
    }
    else if (Error != null)
    {
        <SectionError Message="@Error" />
    }
    else if (Items?.Count == 0)
    {
        <div class="card-body text-muted fst-italic">(none)</div>
    }
    else if (Items != null)
    {
        <div class="list-group list-group-flush">
            @foreach (var mail in Items.OrderBy(m => m.Timestamp))
            {
                <div class="list-group-item list-group-item-action py-2 px-3">
                    <div class="d-flex align-items-center gap-3">
                        <span class="text-muted small text-nowrap">@mail.Timestamp.ToString("HH:mm")</span>
                        @if (mail.IsSent)
                        {
                            <span class="badge rounded-pill bg-success flex-shrink-0">↑ Sent</span>
                        }
                        else
                        {
                            <span class="badge rounded-pill bg-info text-dark flex-shrink-0">↓ Received</span>
                        }
                        <span class="text-muted small text-nowrap counterpart-col">
                            @(mail.IsSent
                                ? $"To: {string.Join(", ", mail.To.Take(2))}{(mail.To.Count > 2 ? $" +{mail.To.Count - 2}" : "")}"
                                : $"From: {mail.From}")
                        </span>
                        <span class="text-truncate small">@mail.Subject</span>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public List<MailMessage>? Items     { get; set; }
    [Parameter] public bool               IsLoading { get; set; }
    [Parameter] public string?            Error     { get; set; }
}
