<SectionCard Title="Email" Icon="📧" Count="@(Items?.Count ?? 0)"
             IsLoading="@IsLoading" Error="@Error" LoadingLabel="Fetching emails…">
    <SummaryContent>
        @if (Items?.Count > 0)
        {
            <text>↑ @Items.Count(m => m.IsSent) sent · ↓ @Items.Count(m => !m.IsSent) received</text>
        }
    </SummaryContent>
    <ChildContent>
        <div class="list-group list-group-flush">
            @foreach (var mail in Items!.OrderBy(m => m.Timestamp))
            {
                <div class="list-group-item list-group-item-action py-2 px-3">
                    <div class="d-flex align-items-center gap-3">
                        <span class="text-muted small text-nowrap">@mail.Timestamp.ToString("HH:mm")</span>
                        @if (mail.IsSent)
                        {
                            <span class="badge rounded-pill bg-success flex-shrink-0">↑ Sent</span>
                        }
                        else
                        {
                            <span class="badge rounded-pill bg-info text-dark flex-shrink-0">↓ Received</span>
                        }
                        <span class="text-muted small text-nowrap counterpart-col">
                            @(mail.IsSent
                                ? $"To: {string.Join(", ", mail.To.Take(2))}{(mail.To.Count > 2 ? $" +{mail.To.Count - 2}" : "")}"
                                : $"From: {mail.From}")
                        </span>
                        @if (!string.IsNullOrEmpty(mail.WebLink))
                        {
                            <a href="@mail.WebLink" target="_blank" rel="noopener" class="text-truncate small text-decoration-none">@mail.Subject 🔗</a>
                        }
                        else
                        {
                            <span class="text-truncate small">@mail.Subject</span>
                        }
                    </div>
                </div>
            }
        </div>
    </ChildContent>
</SectionCard>

@code {
    [Parameter] public List<MailMessage>? Items     { get; set; }
    [Parameter] public bool               IsLoading { get; set; }
    [Parameter] public string?            Error     { get; set; }
}
