<div class="row g-3 mb-4">

    <!-- ─── Messages ─────────────────────────────────────────────────────── -->
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm text-center h-100">
            <div class="card-body py-3">
                <div class="display-6 mb-1">💬</div>
                @if (LoadingMessages)
                {
                    <div class="spinner-border text-primary my-1" style="width:1.6rem;height:1.6rem;" role="status"></div>
                }
                else
                {
                    <div class="fs-2 fw-bold text-primary lh-1">@(Messages?.Count ?? 0)</div>
                    <div class="small mt-1">
                        <span class="text-success">↑ @(Messages?.Count(m => m.IsSentByMe) ?? 0) sent</span>
                        <span class="text-muted mx-1">·</span>
                        <span class="text-info">↓ @(Messages?.Count(m => !m.IsSentByMe) ?? 0) received</span>
                    </div>
                }
                <div class="text-muted small mt-1">Teams Messages</div>
            </div>
        </div>
    </div>

    <!-- ─── Events ───────────────────────────────────────────────────────── -->
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm text-center h-100">
            <div class="card-body py-3">
                <div class="display-6 mb-1">📅</div>
                @if (LoadingEvents)
                {
                    <div class="spinner-border text-primary my-1" style="width:1.6rem;height:1.6rem;" role="status"></div>
                }
                else
                {
                    <div class="fs-2 fw-bold text-primary lh-1">@(Events?.Count ?? 0)</div>
                    @if (Events?.Count > 0)
                    {
                        <div class="small mt-1 text-muted">
                            @((int)Events.Sum(e => e.Duration.TotalMinutes)) min total
                        </div>
                    }
                }
                <div class="text-muted small mt-1">Meetings</div>
            </div>
        </div>
    </div>

    <!-- ─── Emails ───────────────────────────────────────────────────────── -->
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm text-center h-100">
            <div class="card-body py-3">
                <div class="display-6 mb-1">📧</div>
                @if (LoadingEmails)
                {
                    <div class="spinner-border text-primary my-1" style="width:1.6rem;height:1.6rem;" role="status"></div>
                }
                else
                {
                    <div class="fs-2 fw-bold text-primary lh-1">@(Emails?.Count ?? 0)</div>
                    <div class="small mt-1">
                        <span class="text-success">↑ @(Emails?.Count(m => m.IsSent) ?? 0) sent</span>
                        <span class="text-muted mx-1">·</span>
                        <span class="text-info">↓ @(Emails?.Count(m => !m.IsSent) ?? 0) received</span>
                    </div>
                }
                <div class="text-muted small mt-1">Emails</div>
            </div>
        </div>
    </div>

    <!-- ─── Commits ───────────────────────────────────────────────────────── -->
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm text-center h-100">
            <div class="card-body py-3">
                <div class="display-6 mb-1">🔧</div>
                @if (LoadingCommits)
                {
                    <div class="spinner-border text-primary my-1" style="width:1.6rem;height:1.6rem;" role="status"></div>
                }
                else
                {
                    <div class="fs-2 fw-bold text-primary lh-1">@(Commits?.Count ?? 0)</div>
                }
                <div class="text-muted small mt-1">DevOps Commits</div>
            </div>
        </div>
    </div>

</div>

@code {
    [Parameter] public List<TeamMessage>?   Messages       { get; set; }
    [Parameter] public List<CalendarEvent>? Events         { get; set; }
    [Parameter] public List<MailMessage>?   Emails         { get; set; }
    [Parameter] public List<DevOpsCommit>?  Commits        { get; set; }

    [Parameter] public bool LoadingMessages { get; set; }
    [Parameter] public bool LoadingEvents   { get; set; }
    [Parameter] public bool LoadingEmails   { get; set; }
    [Parameter] public bool LoadingCommits  { get; set; }
}
