@page "/"
@rendermode InteractiveServer
@inject DailyActivityService ActivityService
@inject AppConfig Config

<PageTitle>@(_fetchedDate.HasValue ? $"Daily Activity – {_fetchedDate:yyyy-MM-dd}" : "Daily Activity")</PageTitle>

<!-- ─── Toolbar ──────────────────────────────────────────────────────────── -->
<div class="d-flex flex-wrap align-items-center gap-3 mb-4">
    <label class="fw-semibold mb-0">📅 Date:</label>
    <input type="date"
           class="form-control w-auto"
           @bind="_selectedDate"
           @bind:format="yyyy-MM-dd" />
    <button class="btn btn-primary px-4" @onclick="FetchData" disabled="@_isFetching">
        @if (_isFetching)
        {
            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
            <span>Fetching…</span>
        }
        else
        {
            <span>🔍 Fetch Activity</span>
        }
    </button>

</div>

<!-- ─── Auth error ────────────────────────────────────────────────────────── -->
@if (_authError != null)
{
    <div class="alert alert-danger alert-dismissible" role="alert">
        <strong>Authentication error:</strong> @_authError
        <button type="button" class="btn-close" @onclick="() => _authError = null"></button>
    </div>
}

<!-- ─── Activity (visible as soon as fetching starts) ───────────────────── -->
@if (_hasFetched)
{
    <h4 class="mb-3 text-secondary">
        📆 @_selectedDate.ToString("dddd, dd. MMMM yyyy")
    </h4>

    <SummaryCards Messages="@_messages" LoadingMessages="@_loadingMessages"
                  Events="@_events"     LoadingEvents="@_loadingEvents"
                  Emails="@_emails"     LoadingEmails="@_loadingEmails"
                  Commits="@_commits"   LoadingCommits="@_loadingCommits"
                  Tasks="@_todoTasks"   LoadingTasks="@_loadingTodo" />

    @if (Config.EnableMessages) { <MessagesSection Items="@_messages" IsLoading="@_loadingMessages" Error="@_messagesError" /> }
    @if (Config.EnableEvents)   { <EventsSection   Items="@_events"   IsLoading="@_loadingEvents"   Error="@_eventsError" /> }
    @if (Config.EnableEmails)   { <EmailSection    Items="@_emails"   IsLoading="@_loadingEmails"   Error="@_emailsError" /> }
    @if (Config.EnableCommits)  { <CommitsSection  Items="@_commits"  IsLoading="@_loadingCommits"  Error="@_commitsError" /> }
    @if (Config.EnableTodo)     { <TodoSection     Items="@_todoTasks" IsLoading="@_loadingTodo"    Error="@_todoError" /> }
}
else
{
    <div class="text-center text-muted py-5">
        <div class="fs-1 mb-3">📊</div>
        <p class="fs-5">Select a date and click <strong>Fetch Activity</strong> to load your daily summary.</p>
    </div>
}

<!-- ─── Warnings ─────────────────────────────────────────────────────────── -->
@if (Config.ShowWarnings && _warnings.Count > 0)
{
    <div class="alert alert-warning alert-dismissible" role="alert">
        <strong>⚠️ @_warnings.Count Warning(s):</strong>
        <ul class="mb-0 mt-1">
            @foreach (var warning in _warnings)
            {
                <li class="small">@warning</li>
            }
        </ul>
        <button type="button" class="btn-close" @onclick="() => _warnings.Clear()"></button>
    </div>
}



@code {
    private DateTime _selectedDate = DateTime.Today;

    // ─── Per-section state ────────────────────────────────────────────────────

    private List<TeamMessage>?   _messages;
    private List<CalendarEvent>? _events;
    private List<MailMessage>?   _emails;
    private List<DevOpsCommit>?  _commits;
    private List<TodoTask>?      _todoTasks;

    private bool _loadingMessages;
    private bool _loadingEvents;
    private bool _loadingEmails;
    private bool _loadingCommits;
    private bool _loadingTodo;

    private string? _messagesError;
    private string? _eventsError;
    private string? _emailsError;
    private string? _commitsError;
    private string? _todoError;

    // ─── Page-level state ─────────────────────────────────────────────────────

    private bool    _hasFetched;
    private DateTime? _fetchedDate;
    private bool    _isFetching;
    private string? _authError;
    private readonly List<string> _warnings = [];

    private bool AllDone =>
        !_loadingMessages && !_loadingEvents && !_loadingEmails && !_loadingCommits && !_loadingTodo;

    // ─── Fetch ────────────────────────────────────────────────────────────────

    private async Task FetchData()
    {
        _isFetching      = true;
        _hasFetched      = true;
        _fetchedDate     = _selectedDate;
        _authError       = null;
        _warnings.Clear();

        _messages = null;
        _events   = null;
        _emails   = null;
        _commits  = null;
        _todoTasks = null;
        _messagesError = _eventsError = _emailsError = _commitsError = _todoError = null;
        _loadingMessages = Config.EnableMessages;
        _loadingEvents   = Config.EnableEvents;
        _loadingEmails   = Config.EnableEmails;
        _loadingCommits  = Config.EnableCommits;
        _loadingTodo     = Config.EnableTodo;

        try
        {
            var date = DateOnly.FromDateTime(_selectedDate);
            var (graph, email, userId) = await ActivityService.AuthenticateAsync();

            // All four fetchers run simultaneously; each pushes a UI update when done
            await Task.WhenAll(
                RunSection(
                    Config.EnableMessages,
                    () => ActivityService.FetchMessagesAsync(graph, userId, date, AddWarning),
                    r => _messages      = r,
                    e => _messagesError = e,
                    () => _loadingMessages = false),

                RunSection(
                    Config.EnableEvents,
                    () => ActivityService.FetchEventsAsync(graph, date, AddWarning),
                                        r => _events      = r,
                    e => _eventsError = e,
                    () => _loadingEvents = false),

                RunSection(
                    Config.EnableEmails,
                    () => ActivityService.FetchEmailsAsync(graph, date, AddWarning),
                    r => _emails      = r,
                    e => _emailsError = e,
                    () => _loadingEmails = false),

                RunSection(
                    Config.EnableCommits,
                    () => ActivityService.FetchCommitsAsync(email, date, AddWarning),
                    r => _commits      = r,
                    e => _commitsError = e,
                    () => _loadingCommits = false),

                RunSection(
                    Config.EnableTodo,
                    () => ActivityService.FetchTodoTasksAsync(graph, date, AddWarning),
                                        r => _todoTasks  = r,
                    e => _todoError  = e,
                    () => _loadingTodo = false)
            );
        }
        catch (Exception ex)
        {
            _authError = ex.Message;
            _loadingMessages = _loadingEvents = _loadingEmails = _loadingCommits = _loadingTodo = false;
        }
        finally
        {
            _isFetching = false;
        }
    }

    // Collects fetch warnings so they can be shown in a dedicated UI block
    private void AddWarning(string message)
    {
        _warnings.Add(message);
        InvokeAsync(StateHasChanged);
    }

    // Runs one fetcher, updates its state, then pushes the change to the browser
    private async Task RunSection<T>(
        bool           enabled,
        Func<Task<T>>  fetch,
        Action<T>      setResult,
        Action<string> setError,
        Action         setDone)
    {
        if (!enabled)
        {
            setDone();
            return;
        }

        try
        {
            setResult(await fetch());
        }
        catch (Exception ex)
        {
            setError(ex.Message);
        }
        finally
        {
            setDone();
            await InvokeAsync(StateHasChanged);
        }
    }
}
